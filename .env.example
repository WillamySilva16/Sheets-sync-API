# Porta da API
PORT=3000

# Ativa modo demo (dados mockados) quando nao ha conexao real com SQL Server
DEMO_MODE=true

# --- SQL Server ---
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_SERVER=192.168.0.87
DB_DATABASE=SAR2G_RS_PRD
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Google Sheets ---
# Baixe o JSON da service account no Google Cloud Console e coloque o caminho aqui
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
GOOGLE_SPREADSHEET_ID=coloque_o_id_da_planilha_aqui

# --- Agendamento (cron) ---
SYNC_CRON_SCHEDULE=0 8,17 * * *
TZ=America/Sao_Paulo
